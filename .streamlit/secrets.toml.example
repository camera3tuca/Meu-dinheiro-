# Exemplo de configuração de segredos do Streamlit.
# Copie este arquivo para `.streamlit/secrets.toml` (que é ignorado pelo Git)
# e preencha com a string de conexão do seu banco PostgreSQL.
#
# No Streamlit Community Cloud, cole este conteúdo em:
#   App → Settings → Secrets
#
# Sem DATABASE_URL, o app usa um SQLite local (data/meu_dinheiro.db).

DATABASE_URL = "postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"
