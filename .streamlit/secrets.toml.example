# Exemplo de configuração de segredos do Streamlit.
# Copie este arquivo para `.streamlit/secrets.toml` (que é ignorado pelo Git)
# e preencha os valores. No Streamlit Community Cloud, cole este conteúdo em:
#   App → Settings → Secrets

# String de conexão do PostgreSQL (ex.: Neon).
# Sem DATABASE_URL, o app usa um SQLite local (data/meu_dinheiro.db).
DATABASE_URL = "postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"

# Código de convite para criar conta (opcional).
# Se definido, quem quiser se cadastrar precisa informar este código —
# útil para impedir cadastros de estranhos num app público.
# Deixe em branco ou remova para permitir cadastro livre.
# REGISTRATION_CODE = "meu-codigo-secreto"
